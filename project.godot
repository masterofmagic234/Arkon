; ACORN HUNTER — V19 CANONICAL MAP
; Static-first 3D level: the visible world exists in the scene itself.
config_version=5

[application]
config/name="ACORN HUNTER — Операция «Жёлудь» — V19 CANONICAL MAP"
; DEV LEVEL 2: launch the racing level directly while Level 2 is being developed.
; Restore res://menu.tscn here when the Level 2 work is finished.
run/main_scene="res://scenes/level2_pseudo3d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=0

