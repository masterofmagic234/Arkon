; ACORN HUNTER — EXPERIMENTAL LEVEL 1 / DENSE FOUR-ZONE MAP
; Static-first 3D level: the visible world exists in the scene itself.
config_version=5

[application]
config/name="ACORN HUNTER — Операция «Жёлудь» — EXPERIMENTAL LEVEL 1"
; EXPERIMENTAL BUILD: boot directly into the dense four-zone Level 1.
run/main_scene="res://game.tscn"
run/dev_force_level1_dense=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
SignalBus="*res://scripts/signal_bus.gd"

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="expand"
handheld/orientation=0

